---
import type { Props } from "@astrojs/starlight/props";
---

<a href="/" class="site-title">
  <picture class="kintsu-logo">
    <source
      type="image/png"
      srcset="/favicons/favicon-32x32.png 32w, /favicons/favicon-48x48.png 48w, /favicons/favicon-96x96.png 96w"
      sizes="2rem"
    />
    <img src="/favicon.svg" alt="Kintsu logo" width="32" height="32" fetchpriority="high" />
  </picture>
  kintsu
</a>

<style>
  .site-title {
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--sl-color-white);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .site-title:hover {
    color: var(--sl-color-white);
    opacity: 0.9;
  }

  .kintsu-logo {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .kintsu-logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
