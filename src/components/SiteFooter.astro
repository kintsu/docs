---
/**
 * SiteFooter Component
 *
 * Site-wide footer displaying copyright, legal links, and branding.
 * This component is rendered below the Starlight default footer.
 */
---

<footer class="site-footer">
  <div class="footer-content">
    <div class="footer-brand">
      <span class="brand-name">kintsu</span>
      <span class="brand-separator">|</span>
      <span class="brand-years">2025–{new Date().getFullYear()}</span>
    </div>

    <nav class="footer-links" aria-label="Legal">
      <a href="/legal/licensing/">Licensing</a>
      <span class="link-separator">·</span>
      <a href="/legal/privacy/">Privacy</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--sl-color-gray-5);
    padding: 1.5rem 1rem;
    margin-top: 2rem;
    background: var(--sl-color-black);
  }

  .footer-content {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand-name {
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .brand-separator {
    color: var(--sl-color-gray-4);
  }

  .brand-years {
    color: var(--sl-color-gray-3);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-links a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
  }

  .link-separator {
    color: var(--sl-color-gray-4);
  }

  @media (max-width: 50rem) {
    .footer-content {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
