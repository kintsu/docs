---
import type { Props } from "@astrojs/starlight/props";
import { Pencil } from "@lucide/astro";

const { editUrl } = Astro.locals.starlightRoute;
---

{
  editUrl && (
    <a href={editUrl} class="edit-link print:hidden" title="Edit this page on GitHub">
      <Pencil class="edit-icon" />
      <span class="edit-text">Edit</span>
    </a>
  )
}

<style>
  .edit-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border-radius: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--sl-color-gray-3);
    transition: all 0.15s ease;
    opacity: 0.7;
    border: 1px solid transparent;
  }

  .edit-link:hover {
    opacity: 1;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-5);
  }

  .edit-link:focus-visible {
    opacity: 1;
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .edit-icon {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
  }

  .edit-text {
    line-height: 1;
  }

  /* Make it even more discrete on mobile */
  @media (max-width: 768px) {
    .edit-link {
      opacity: 0.6;
      font-size: 0.75rem;
      padding: 0.25rem 0.5rem;
    }

    .edit-icon {
      width: 0.8125rem;
      height: 0.8125rem;
    }
  }
</style>
